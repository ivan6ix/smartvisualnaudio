VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Production environment scan: the authenticated Edge Function, e.g. https://<project>.supabase.co/functions/v1/environment-scan.
# When set, every scan angle must pass through it. Its Roboflow key lives only in Supabase function secrets.
VITE_ENV_SCAN_ENDPOINT=
VITE_ROBOFLOW_ENV_SCAN_ENDPOINT=http://localhost:3001/api/environment-scan
VITE_ROBOFLOW_PROXY_URL=http://localhost:3001/api/init-webrtc
# Never put a Roboflow private key in a VITE_* variable: referenced VITE_* values are bundled into browser JavaScript.
VITE_ROBOFLOW_WORKSPACE=ivans-workspace-ebbgr
VITE_ROBOFLOW_WORKFLOW_ID=detect-count-and-visualize-7
VITE_ROBOFLOW_STREAM_OUTPUTS=
VITE_ROBOFLOW_DATA_OUTPUTS=model_output
VITE_ROBOFLOW_PLAN=webrtc-gpu-medium
VITE_ROBOFLOW_REGION=us
# Server-only (local proxy). For the Edge Function set ROBOFLOW_API_KEY, ROBOFLOW_ENV_MODEL_ID, ROBOFLOW_ENV_MODEL_VERSION
# (and optionally ROBOFLOW_ENV_API_BASE) with `supabase secrets set`, or ENV_SCAN_DETECTOR_ENDPOINT for another detector.
ROBOFLOW_API_KEY=
ROBOFLOW_ENV_MODEL_ID=spare-gadget-detection
ROBOFLOW_ENV_MODEL_VERSION=16
ROBOFLOW_ENV_CONFIDENCE=0.35
ROBOFLOW_ENV_API_BASE=https://detect.roboflow.com
ROBOFLOW_PROXY_PORT=3001
ROBOFLOW_PROXY_ORIGIN=http://localhost:5173
